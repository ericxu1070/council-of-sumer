# Copy to .env (git-ignored) and fill in. Never commit .env.

# LLM: "bayleaf" uses the API below; "mock" runs the deterministic policy offline.
LLM_MODE=bayleaf
BAYLEAF_API_KEY=
# OpenAI-compatible base URL, ending in /v1 (no trailing /chat/completions)
BAYLEAF_BASE_URL=https://api.bayleaf.dev/v1
BAYLEAF_MODEL=openrouter:deepseek/deepseek-v4.1-flash
LLM_TIMEOUT_S=25
# Existing spend cap (USD). Exhaustion is a technical failure after one retry.
LLM_BUDGET_USD=3.00
# Existing per-prompt response cache. Recorded run replay uses SQLite and makes no calls.
LLM_CACHE=true

# AGNTCY SLIM
TRANSPORT=slim
SLIM_HOST=127.0.0.1
SLIM_PORT=46357
# At least 32 characters. Every advisor and the clerk must share it.
SLIM_SHARED_SECRET=council-of-sumer-dev-secret-change-me-0123456789

MAX_ROUNDS=5
WEB_PORT=8000

# Durable run journal and local advisor signing credentials
# SUMER_DB_PATH=.cache/runs.sqlite3
# SUMER_IDENTITY_DIR=.cache/identities

# Optional: ElevenLabs voices for the advisors
ELEVENLABS_API_KEY=
