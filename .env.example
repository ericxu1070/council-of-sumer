# Copy to .env (git-ignored) and fill in. Never commit .env.

# LLM: "bayleaf" uses the API below; "mock" runs the deterministic policy offline.
LLM_MODE=bayleaf
BAYLEAF_API_KEY=
# OpenAI-compatible base URL, ending in /v1 (no trailing /chat/completions)
BAYLEAF_BASE_URL=https://api.bayleaf.dev/v1
BAYLEAF_MODEL=openrouter:deepseek/deepseek-v4.1-flash
LLM_TIMEOUT_S=25
# Hard stop on real spend (USD). Past it, advisors fall back to the offline policy.
LLM_BUDGET_USD=3.00
# Replay cached LLM replies from .cache/llm so the venue demo survives bad Wi-Fi
LLM_CACHE=true

# AGNTCY SLIM
TRANSPORT=slim
SLIM_HOST=127.0.0.1
SLIM_PORT=46357
# At least 32 characters. Every advisor and the clerk must share it.
SLIM_SHARED_SECRET=council-of-sumer-dev-secret-change-me-0123456789

# Rounds of turns per year (each round, all seven advisors speak once, in turn)
MAX_ROUNDS=6
# Years in a reign (the 1968 original ran 10)
REIGN_YEARS=5
# Seconds between council messages in the live chamber (also POST /api/pace)
PACE_S=1.0
# 0 = wait for the human as long as it takes
ESCALATION_TIMEOUT_S=0
WEB_PORT=8000

# Optional: ElevenLabs voices for the advisors and the narrator
ELEVENLABS_API_KEY=
# Override any voice, e.g. ELEVENLABS_VOICE_NARRATOR=JBFqnCBsd6RMkjVDRZzb (George)
# ELEVENLABS_VOICE_NARRATOR=

# Immutable council journal and local advisor signing credentials
# SUMER_DB_PATH=.cache/runs.sqlite3
# SUMER_IDENTITY_DIR=.cache/identities

# Local AGNTCY Observe pipeline, started by sumer up
SUMER_OBSERVE=true
OTLP_HTTP_ENDPOINT=http://127.0.0.1:4318
# SUMER_TRACE_PATH=.cache/otel-traces.jsonl
# SUMER_COLLECTOR_BINARY=.cache/bin/otelcol-contrib
